{
  "$schema": "https://mintlify.com/docs/mint-schema.json",
  "theme": "maple",
  "name": "DashSquad",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.dashsquad.ai"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "fonts": {
    "heading": { "family": "Outfit", "weight": 700 },
    "body": { "family": "Outfit", "weight": 400 }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [{ "label": "dashsquad.ai", "href": "https://www.dashsquad.ai" }],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/volumegambit/Dash/releases/latest"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "how-dashsquad-works", "getting-started"]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "agents",
              "mission-control",
              "ios",
              "web",
              "projects",
              "messaging-apps",
              "remote-access",
              "ai-providers",
              "skills",
              "memory",
              "tools",
              "browser",
              "plugins",
              "secrets"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "deploy-your-first-agent",
              "chat-with-your-agent",
              "example-agents",
              "extended-thinking"
            ]
          },
          {
            "group": "Reference",
            "pages": ["configuration", "api-reference", "architecture"]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting"]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/how-dash-works", "destination": "/how-dashsquad-works", "permanent": true }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/volumegambit/Dash",
      "website": "https://www.dashsquad.ai"
    }
  }
}
